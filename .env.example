# Copy this file to .env.local for local development:
#   cp .env.example .env.local   (Windows: copy .env.example .env.local)
# On Netlify/Vercel, add the same variables in the site's Environment variables settings.

# Required for the contact form. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=dipanadia34@gmail.com

# Sender address. Until you verify your own domain in Resend, keep this default.
# With onboarding@resend.dev, Resend only delivers to the email your Resend account was created with.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Optional. Your deployed URL, used for Open Graph / SEO metadata.
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
